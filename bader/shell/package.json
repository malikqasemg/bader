{
  "name": "bader-windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "predev": "cargo build --release -p bader-hook",
    "prebuild": "cargo build --release -p bader-hook",
    "pack": "tauri build && node scripts/pack.mjs",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "mac": "tauri build --bundles app,dmg"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
